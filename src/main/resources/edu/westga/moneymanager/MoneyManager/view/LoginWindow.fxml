<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="400.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.moneymanager.MoneyManager.view.LoginWindow">
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Money Manager Login" />
    <TextField fx:id="usernameInput" maxWidth="200.0" promptText="Username" />
    <PasswordField fx:id="passwordInput" maxWidth="200.0" promptText="Password" />
    <Button onAction="#handleLogin" text="Login" />
    <Label fx:id="errorLabel" textFill="RED" />
</VBox>